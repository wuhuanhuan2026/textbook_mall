# ========================================
# 教材商城系统 - .gitignore
# ========================================

# ===== Maven =====
target/
!**/src/main/**/target/
!**/src/test/**/target/
!.mvn/wrapper/maven-wrapper.jar

# ===== 后端多模块 =====
backend/*/target/
backend/target/

# ===== Kotlin =====
.kotlin

# ===== IntelliJ IDEA =====
.idea/
.idea
*.iws
*.iml
*.ipr

# ===== Eclipse =====
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# ===== NetBeans =====
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/

# ===== VS Code =====
.vscode/

# ===== 前端 =====
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/*.local
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/pnpm-debug.log*

# ===== 环境变量 =====
.env
.env.local
.env.*.local

# ===== 日志 =====
*.log
logs/
backend/*/logs/

# ===== 系统 =====
.DS_Store
Thumbs.db

# ===== 临时文件 =====
*.tmp
*.bak
*.swp
*~

# ===== 敏感信息 =====
application-local.yml
application-local.properties
*-secret.yml
*-secret.properties

# ===== 构建产物 =====
*.jar
*.war
*.ear
*.class
backend/_backup-config/
backend/META-INF/
