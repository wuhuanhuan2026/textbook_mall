# ============================================================
# 教材商城系统 - 环境变量样例
# 复制为 .env 或按需设置系统环境变量
# 不要提交真实密码到 Git
# ============================================================
# ---------- 数据库 ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=book_mall
DB_USERNAME=root
DB_PASSWORD=CHANGE_ME
# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=1
# ---------- Nacos ----------
NACOS_SERVER_ADDR=127.0.0.1:8848
NACOS_NAMESPACE=public
NACOS_GROUP=DEFAULT_GROUP
# ---------- JWT ----------
JWT_SECRET=CHANGE_TO_A_LONG_RANDOM_VALUE_AT_LEAST_32_CHARS
JWT_EXPIRATION=604800000
# ---------- Druid 监控 ----------
DRUID_LOGIN_USERNAME=admin
DRUID_LOGIN_PASSWORD=CHANGE_ME
